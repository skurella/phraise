    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "prosemirror-model": "^1.23.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-transform": "^1.10.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "ws": "^8.18.0",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
