{
  "name": "daemon-file-sync-fork-import",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spike 3: local daemon materializing a live Yjs document as a file, importing file saves as attributed CRDT operations by fork-at-base.",
  "scripts": {
