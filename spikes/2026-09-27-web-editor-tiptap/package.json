{
  "name": "web-editor-tiptap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spike 7, brief 01: foundation of the web editor. Tiptap 3 on the Phraise schema, spike 5's Yjs 13 workarounds, Hocuspocus 4.7 relay with SQLite, a Vite-built vanilla-TS page, and a Playwright harness with a gate reporter.",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup": "npm run setup:browsers && npm run setup:corpus",
    "setup:browsers": "PLAYWRIGHT_BROWSERS_PATH=.pw-browsers playwright install chromium firefox webkit",
    "setup:corpus": "node scripts/fetch-corpus.mjs",
    "gates": "npm run build && PLAYWRIGHT_BROWSERS_PATH=.pw-browsers playwright test",
    "start": "tsx scripts/start.ts"
  },
  "dependencies": {
    "@hocuspocus/extension-sqlite": "4.7.0",
    "@hocuspocus/provider": "4.7.0",
    "@hocuspocus/server": "4.7.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-collaboration": "3.31.3",
    "@tiptap/extension-collaboration-caret": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/y-tiptap": "3.0.9",
    "dompurify": "^3.4.16",
    "katex": "^0.18.9",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.0.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mermaid": "^11.17.2",
    "prosemirror-commands": "^1.6.2",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.23.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-transform": "^1.10.2",
    "prosemirror-view": "^1.37.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "ws": "^8.18.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "commonmark-spec": "^0.31.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^3.0.5"
  }
}
